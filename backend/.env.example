# Copiar este archivo a ".env" en esta misma carpeta (backend/) y ajustar si
# hace falta. Estos son los mismos valores que ya trae server/db.js como
# default en el codigo, asi que si no se crea el .env la app arranca igual
# con estos datos -- pero es mejor practica tener el .env explicito.
#
# IMPORTANTE: la base de datos (MariaDB) de este proyecto ya vive en este
# mismo servidor (10.23.105.36 == VLC-OPSQL-PRD), segun el default que ya
# tenia el codigo. Al correr la app AQUI, DB_HOST puede quedar como
# localhost (mas rapido, sin salir por red) o como 10.23.105.36 (tambien
# deberia funcionar, es la misma maquina). Probar localhost primero.
DB_NAME=tickets_db
DB_USER=tickets_user
DB_PASSWORD=TktPass2026!
DB_HOST=localhost
DB_PORT=3306
PORT=4000

# Notificaciones por correo (backend/services/emailService.js, agregado 2026-08-27).
# Opcional: si SMTP_USER/SMTP_PASS quedan vacios, el envio de correos se omite en
# silencio (solo un warning en el log) -- el resto de la app sigue funcionando igual.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Base usada para armar los links "Ver Ticket" dentro de los correos
# (http://<esta-ip>:5173/tickets/<id>) -- debe apuntar a donde los usuarios
# realmente entran a la app, no a localhost.
FRONTEND_URL=http://10.23.105.36:5173

# Firma los tokens de descarga de adjuntos (/api/uploads, agregado 2026-08-27).
# Trae un default en el codigo (server.js) para que la app funcione sin .env, pero
# en un despliegue real conviene fijar esto a un secreto propio -- si se cambia,
# los tokens ya emitidos (validos solo 15 min) dejan de servir, sin ningun otro
# efecto.
DOWNLOAD_TOKEN_SECRET=

# API key para GET /api/export/tickets (agregado 2026-08-27) -- exportacion de
# tickets de Volcan Desk (mismos campos que el boton "Exportar CSV") para el
# sistema externo que concentra las APIs de Volcan. A diferencia de
# DOWNLOAD_TOKEN_SECRET, esta NO trae default en el codigo -- si se deja vacio,
# la ruta queda inaccesible (401) en vez de aceptar cualquier llamada sin llave.
# Hay que generar un valor propio aqui (string aleatorio largo) antes de que el
# sistema externo pueda usar esta API.
EXPORT_API_KEY=
